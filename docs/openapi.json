    "/auth/password": {
      "patch": {
        "tags": [
          "Auth"
        ],
        "summary": "Cambia la contrasena y reinicia las sesiones",
        "description": "Requiere sesion. Verifica la contrasena actual (si no coincide, 401 `CREDENCIALES_INVALIDAS`), guarda la nueva, revoca TODAS las sesiones del usuario (incluida la actual) y abre una sesion nueva, reemitiendo las cookies para que quien cambio la clave siga dentro. Las demas sesiones quedan cerradas. 204.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "passwordActual": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128
                  },
                  "passwordNueva": {
                    "type": "string",
                    "minLength": 10,
                    "maxLength": 128
                  }
                },
                "required": [
                  "passwordActual",
                  "passwordNueva"
                ],
                "additionalProperties": false
              },
              "example": {
                "passwordActual": "clave-segura-123",
                "passwordNueva": "clave-aun-mas-segura-456"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contrasena cambiada; el resto de sesiones fue revocado",
            "headers": {
              "Set-Cookie": {
                "description": "Cookies httpOnly de sesion: access_token (15 min, Path=/) y refresh_token (7 dias, Path=/api/v1/auth). El front debe usar credentials: \"include\".",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos (body, query o params) o regla de negocio incumplida",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorValidacion"
                }
              }
            }
          },
          "401": {
            "description": "No hay sesion valida, el token expiro o las credenciales son incorrectas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Demasiadas peticiones desde esta IP en la ventana de tiempo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Error inesperado del servidor (el detalle solo queda en los logs)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
