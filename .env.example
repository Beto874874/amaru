# ------------------------------------------------------------------
# Plantilla de variables de entorno. Copiar a .env y completar.
# .env NO se versiona (esta en .gitignore).
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000

# --- Conexion a Supabase ---
# DATABASE_URL: la que usa la app en ejecucion.
#   Produccion: transaction pooler (puerto 6543, usuario postgres.<ref>)
#   Desarrollo: basta el session pooler (puerto 5432, compatible IPv4)
DATABASE_URL=postgresql://postgres.<ref>:<password>@<host-pooler>:6543/postgres

# DIRECT_URL: la que usa drizzle-kit (pull).
#   Directa (db.<ref>.supabase.co:5432) si la red soporta IPv6;
#   si no, el session pooler (5432).
DIRECT_URL=postgresql://postgres.<ref>:<password>@<host>:5432/postgres

# Ruta al certificado CA de Supabase (opcional en desarrollo).
# En produccion conviene configurarlo para verificar el certificado.
DB_SSL_CA_PATH=

# Desactivar SOLO para una base local de pruebas que no soporte SSL.
DB_SSL=true

# --- JWT (los dos secretos DEBEN ser distintos y de al menos 32 bytes) ---
# Generar: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia-esto-64-bytes-hex
JWT_REFRESH_SECRET=cambia-esto-OTRO-distinto
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# --- Cookies ---
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- CORS (lista explicita separada por comas; nunca * con credentials) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3001

# --- Red / proxy ---
TRUST_PROXY=false

# --- Logs ---
LOG_LEVEL=info

# --- Documentacion ---
# Origen del propio API (necesario para que el "Try it out" de Swagger UI
# pase el originCheck). Debe coincidir con el host real.
API_PUBLIC_URL=http://localhost:3000
DOCS_ENABLED=true
